# LLM 代理：Vercel AI Gateway
# 浏览器请求 /api/llm，由服务端注入以下密钥后转发
VERCEL_AI_GATEWAY_URL=https://ai-gateway.vercel.com/v1/chat/completions
VERCEL_AI_GATEWAY_KEY=

# 图生 3D：Tripo API
# 浏览器请求 /api/model，由服务端注入以下密钥后转发
TRIPO_API_KEY=

# 导演使用的模型型号（支持图片输入）
# 例：openai/gpt-4o、anthropic/claude-3-5-sonnet-20241022
DIRECTOR_MODEL=
